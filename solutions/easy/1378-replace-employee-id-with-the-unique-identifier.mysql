// ─────────────────────────────────────────────────
//  Problem : 1378. Replace Employee ID With The Unique Identifier
//  Difficulty : Easy
//  Runtime  : 1161 ms
//  Memory   : 0B
//  Solved   : 2026-09-12
// ─────────────────────────────────────────────────

# Write your MySQL query statement below

select  eu.unique_id, e.name 
    from Employees as e LEFT JOIN  EmployeeUNI as eu on e.id=eu.id;